# no callbacks into the CLI. Regenerate after upgrading enconvert.

_enconvert_known_path() {
  case "$1" in
    "convert"|"data"|"compress"|"pdf"|"markdown"|"url"|"url pdf"|"url screenshot"|"url markdown"|"site"|"site pdf"|"site screenshot"|"perceive"|"perceive get"|"perceive batch"|"perceive batch get"|"perceive batch cancel"|"discover"|"lookup"|"distill"|"ingest"|"ingest create"|"ingest files"|"ingest list"|"ingest get"|"ingest cancel"|"ingest retry-webhook"|"ingest webhook-secret"|"ingest webhook-secret show"|"ingest webhook-secret rotate"|"jobs"|"jobs get"|"jobs batch"|"jobs wait"|"files"|"files download"|"formats"|"params"|"params convert"|"whoami"|"status"|"usage"|"version"|"docs"|"open"|"auth"|"auth login"|"auth logout"|"auth status"|"auth token"|"auth switch"|"config"|"config get"|"config set"|"config unset"|"config list"|"config edit"|"config path"|"config debug"|"api"|"completion"|"upgrade"|"mcp"|"mcp install"|"mcp uninstall"|"mcp list"|"help") return 0 ;;
  esac
  return 1
}

